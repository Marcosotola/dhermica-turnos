rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an administrator or a promoter
    function isAdmin() {
      return request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'promotor' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'secretary');
    }

    // --- Treatments (public read for landing page) ---
    match /treatments/{treatmentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Impact Gallery (public read for landing page) ---
    match /impact_gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Community Posts (public read for landing page) ---
    match /community_posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if request.auth != null && (
        // Allow if the user is the owner
        resource.data.userId == request.auth.uid ||
        // Allow if the user is an admin
        isAdmin() ||
        // Allow if ONLY the 'likes' field is being modified
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
      );
    }

    // Helper: true for any authenticated non-client role
    function isNotClient() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'client';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // --- Aparato Sessions (internal scheduling — clients cannot read) ---
    match /aparato_sessions/{sessionId} {
      allow read: if isNotClient();
      allow write: if isAdmin();
    }

    // --- Default rules for all other collections ---
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
